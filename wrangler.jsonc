{
  "name": "oussama",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Base de données de la caisse (créée automatiquement au déploiement, tables créées au premier appel)
  "d1_databases": [{ "binding": "DB", "database_name": "famille-best-caisse" }],
  // Instantané interne hebdomadaire (dimanche 03h00 UTC), 20 conservés
  "triggers": { "crons": ["0 3 * * 0"] }
}
